rules_version = '2';

// อ่านคู่กับ api/login.js: ที่นั่นคือจุดเดียวที่ verify รหัสนักเรียน/บุคลากรจริง
// (ใช้ Admin SDK ข้าม rules พวกนี้ได้) แล้ว mint custom token พร้อม claim "role"
// ไฟล์นี้เชื่อ request.auth.uid / request.auth.token.role เพราะมีแค่ server
// ฝั่งนั้นเท่านั้นที่ตั้งค่าได้ — client ปลอมไม่ได้ไม่ว่าจะแก้ localStorage ยังไง
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function role() { return isSignedIn() ? request.auth.token.role : null; }
    function isRole(r) { return role() == r; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isStaff() { return isRole('academic') || isRole('teacher') || isRole('barista'); }

    // บัญชีผู้ใช้ (ชื่อ, role, ยอดเงินในบัตร ฯลฯ) — id ตรงกับ Firebase Auth uid เป๊ะ
    // (นักเรียน = user_{id}, บุคลากร = {id} — ดู usersDocIdFor ใน AuthContext.jsx)
    match /users/{uid} {
      allow get: if isOwner(uid) || isRole('academic');
      allow list: if isRole('academic');
      // เจ้าของแก้ได้แค่ card_balance ฟิลด์เดียว (เติมเงิน/จ่ายกาแฟ) ฝ่ายวิชาการแก้ได้ทุกฟิลด์
      allow update: if isRole('academic')
        || (isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['card_balance']));
      allow create, delete: if isRole('academic');
    }

    // ตารางรายชื่อนักเรียนดิบ — ใช้ตอน login ฝั่ง server เท่านั้น (Admin SDK ข้าม rules อยู่แล้ว)
    // และแผงจัดการนักเรียนของฝ่ายวิชาการ ไม่มีหน้าไหนในแอปที่นักเรียน/ครูอ่านตรงนี้เลย
    match /students/{studentId} {
      allow read, write: if isRole('academic');
    }

    // ออเดอร์กาแฟ
    match /coffee_orders/{orderId} {
      // สร้างออเดอร์ของตัวเองเท่านั้น (student_id ต้องตรงกับ uid ที่ล็อกอินอยู่)
      allow create: if isSignedIn() && request.resource.data.student_id == request.auth.uid;
      // อ่านออเดอร์ตัวเอง หรือ staff อ่านทั้งหมดเพื่อจัดคิว
      allow read: if isSignedIn() && (resource.data.student_id == request.auth.uid || isStaff());
      // เปลี่ยนสถานะคิวได้เฉพาะบาริสต้า
      allow update: if isRole('barista');
      allow delete: if false;
    }

    // ตารางสอน (ใช้แจ้งครูสอนแทนจากแผงฝ่ายวิชาการ — หน้านักเรียนอ่านจาก Google Sheets แล้ว)
    match /timetable/{classId} {
      allow read: if isSignedIn();
      allow write: if isRole('academic');
    }

    // แจ้งเตือนครูสอนแทน / ประกาศกิจกรรม — ประกาศจากฝ่ายวิชาการเท่านั้น
    match /substitutions/{id} {
      allow read: if isSignedIn();
      allow write: if isRole('academic');
    }
    match /events/{id} {
      allow read: if isSignedIn();
      allow write: if isRole('academic');
    }

    // ปิดทุกอย่างที่ไม่ได้ระบุไว้ข้างบน (deny by default)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
