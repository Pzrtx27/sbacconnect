# ============================================================
# ตัวแปรสภาพแวดล้อมของ SBAC Connect
#
# วิธีใช้: คัดลอกไฟล์นี้เป็น .env.local แล้วเติมค่าจริง
#   cp .env.example .env.local
#
# .env.local ถูก .gitignore ไว้แล้ว (ผ่านกฎ *.local) จึงไม่หลุดขึ้น git
# ห้ามใส่ค่าจริงลงในไฟล์ .env.example นี้เด็ดขาด เพราะไฟล์นี้ถูก commit ขึ้น repo
# ============================================================

# ------------------------------------------------------------
# Supabase — ระบบยืนยันตัวตน ฐานข้อมูล และ storage ทั้งหมดของแอป
# หาค่าได้ที่ Supabase Dashboard > Project Settings > API
# ------------------------------------------------------------

# URL ของโปรเจกต์ เช่น https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=

# anon / public key เท่านั้น
# ห้ามใส่ service_role key ที่นี่โดยเด็ดขาด — ตัวแปรที่ขึ้นต้นด้วย VITE_ จะถูก
# ฝังลงไฟล์ JavaScript ที่ส่งให้เบราว์เซอร์ ใครเปิด devtools ก็อ่านได้
# service_role ข้าม RLS ได้ทุกข้อ = เท่ากับเปิดฐานข้อมูลทั้งก้อนให้สาธารณะ
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------
# PromptPay — ใช้สร้าง QR สำหรับหน้าเติมเงิน (src/config/promptpay.js)
# ใส่เบอร์พร้อมเพย์ 10 หลัก หรือเลขประจำตัวผู้เสียภาษี 13 หลัก
# ถ้าเว้นว่างไว้ หน้าเติมเงินจะยังใช้ได้แต่ไม่มี QR ให้สแกน
# ------------------------------------------------------------
VITE_PROMPTPAY_ID=

# ชื่อบัญชีที่แสดงใต้ QR ให้ผู้ใช้ตรวจก่อนโอน (เว้นว่างได้)
VITE_PROMPTPAY_ACCOUNT_NAME=

# ------------------------------------------------------------
# หมายเหตุเรื่อง Firebase
# ระบบย้ายมา Supabase ทั้งหมดแล้ว src/config/firebase.js เป็น stub ที่ปิดตายไว้
# ไม่ต้องตั้งค่า FIREBASE_* ใด ๆ อีก และ endpoint api/login.js ที่เคยใช้
# firebase-admin ถูกลบออกไปแล้วเพราะเป็นช่องทางเข้าระบบที่ไม่มีใครดูแล
# ------------------------------------------------------------
